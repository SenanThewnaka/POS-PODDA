# Payments.lk Secret API Key (from https://payments.lk dashboard)
# To set in production:
# firebase functions:secrets:set PAYMENTS_LK_SECRET_KEY
PAYMENTS_LK_SECRET_KEY=your_payments_lk_secret_key_here

# Dedicated webhook signing secret from the Payments.lk endpoint settings.
# Store it in Firebase Secret Manager; do not reuse the API key.
# firebase functions:secrets:set PAYMENTS_LK_WEBHOOK_SECRET
PAYMENTS_LK_WEBHOOK_SECRET=your_payments_lk_webhook_secret_here
